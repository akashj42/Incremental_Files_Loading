# ---------------------------------------------------------
# 6. Contact
# ---------------------------------------------------------

contact_df = glueContext.create_dynamic_frame.from_options(

    connection_type="s3",

    connection_options={
        "paths": [
            f"{SOURCE_BUCKET}/Contact/"
        ]
    },

    format="csv",

    format_options={
        "withHeader": True,
        "separator": ",",
        "optimizePerformance": True
    },

    transformation_ctx="contact_source"
